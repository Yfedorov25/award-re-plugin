{
  "id": "frame-scrub-img",
  "params": {
    "framePath": { "default": "renders/arrival-frames/", "type": "string", "note": "directory holding the sequence" },
    "pattern":   { "default": "f_###.webp", "type": "string", "note": "### = zero-padded index" },
    "count":     { "default": 120, "type": "int", "note": "number of frames in the sequence" },
    "from":      { "default": 1, "type": "int", "note": "first frame index" },
    "pad":       { "default": 3, "type": "int", "note": "zero-pad width; defaults to the # run length" },
    "pinFactor": { "default": 2.4, "type": "float", "note": "pin length = innerHeight * pinFactor (longer = slower scrub)" },
    "hold":      { "default": 0.06, "type": "float", "range": [0, 0.2], "note": "fraction of the END held on the last frame (a breath at the climax)" },
    "manageLenis": { "default": true, "type": "bool" }
  },
  "ease": "linear-scrub",
  "motion_props": ["opacity"],
  "webgl": false
}
