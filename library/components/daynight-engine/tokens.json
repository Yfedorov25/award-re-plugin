{
  "id": "daynight-engine",
  "axes": {
    "driver": ["toggle", "scrub", "cursor", "hover", "autoloop", "manual"],
    "reveal": ["opacity", "seam", "portal"]
  },
  "defaults": {
    "mode": "scrub",
    "reveal": "opacity",
    "seamAxis": "x",
    "seamFrom": "right",
    "portalOrigin": "50% 50%",
    "ease": 0.5,
    "rest": 0,
    "loopPeriod": 8,
    "scrim": 0,
    "glow": false
  },
  "cinematic": {
    "glowGradient": "radial-gradient(60% 35% at 58% 56%, rgba(232,201,160,0.16), transparent 70%)",
    "scrimGradient": "linear-gradient(to top, rgba(12,12,11,0.9) 0%, rgba(12,12,11,0.32) 34%, transparent 62%)",
    "seamColor": "#f3f1ec",
    "seamGrip": 44
  },
  "scrub": { "start": "top top", "end": "+=110%", "pin": true, "anticipatePin": 1 },
  "cursor": { "quickToDuration": 0.5, "quickToEase": "power3.out", "clampMin": 0.06, "clampMax": 0.94 },
  "laws": ["no-webgl", "no-canvas-drawimage", "no-mix-blend", "no-backdrop-filter", "frame-matched-pairs-only", "night-eager-load", "reduced-motion-static"]
}
