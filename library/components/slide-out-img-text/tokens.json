{
  "$schema": "../../CONTRACT.md#tokens",
  "id": "slide-out-img-text",
  "entry": "SlideOutImgText.init(root, opts)",
  "params": {
    "layout": {
      "type": "array<{fx,fy,rot,scl}>",
      "default": [
        { "fx": -0.74, "fy": -0.36, "rot": 0, "scl": 0.86 },
        { "fx": 0.74,  "fy": -0.40, "rot": 0, "scl": 0.78 },
        { "fx": -0.70, "fy": 0.40,  "rot": 0, "scl": 0.80 },
        { "fx": 0.72,  "fy": 0.42,  "rot": 0, "scl": 0.82 }
      ],
      "meaning": "END position of each card as a fraction of half the stage (responsive); cards[i] gets layout[i]"
    },
    "start": {
      "type": "array<{tx,ty,rot,scl}>",
      "default": [
        { "tx": -14, "ty": 0,  "rot": -7, "scl": 0.96 },
        { "tx": 18,  "ty": -6, "rot": 6,  "scl": 0.92 },
        { "tx": -6,  "ty": 10, "rot": -3, "scl": 0.98 },
        { "tx": 10,  "ty": 4,  "rot": 4,  "scl": 0.94 }
      ],
      "meaning": "stacked-deck start state — a small fan so it reads as a hand of cards"
    },
    "scrub":  { "type": "boolean|number", "default": 1, "meaning": "ScrollTrigger scrub smoothing" },
    "endVH":  { "type": "number", "default": 120, "unit": "%vh", "meaning": "scroll length for the fan + caption handoff" },
    "travel": { "type": "number", "default": 1.0, "meaning": "fan travel multiplier over stage half-size" }
  }
}
