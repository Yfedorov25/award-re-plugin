{
  "id": "locmap-engine",
  "defaults": {
    "mScale": 2.6,
    "walkMin": 10,
    "modes": ["loc", "infra"],
    "flickerRate": 9,
    "route": true,
    "ease": "award"
  },
  "reveal": { "start": "top 58%", "once": true, "gates": 9 },
  "parallax": { "green": 1.2, "buildings": 2, "pins": 3 },
  "roadRanks": ["faint", "minor", "mid", "main", "hwy"],
  "roadWidths": {
    "hwy":   { "stroke": 7,   "casing": 11 },
    "main":  { "stroke": 5,   "casing": 9 },
    "mid":   { "stroke": 3.4, "casing": 6 },
    "minor": { "stroke": 2.2, "casing": 4 },
    "faint": { "stroke": 1.2, "casing": 0 }
  },
  "litWindow": { "formula": "(i*2654435761>>>0)%rate===0", "rate": 9, "share": "~11%" },
  "touch": { "hitRadius": 22, "tapPx": 44 },
  "ring": { "metresPer10min": 833 },
  "colors": {
    "ink": "#f3f1ec",
    "field": ["#161410", "#0b0a08"],
    "accent": "#b06a4f",
    "accentSoft": "#c98a72",
    "litRgb": "236,178,118"
  },
  "dataShape": {
    "viewBox": "string",
    "site": "{x,y,label?,tag?}",
    "green": "[{d, cls}]",
    "buildings": "[d_path_string]",
    "roads": "[{cls, name, pts:[[x,y]...]}]",
    "names": "[{x,y,a?,n}]",
    "pois": "[{id,label,x,y,m,walk,drive,route:[[x,y]...]}]",
    "infra": "{ [cat]: { count, pins:[{x,y}] } }"
  },
  "pipeline": "Overpass/OSM -> projector (lat/lon -> viewBox px, auto-fit on site+POIs) -> emit path d-strings + POI/route metadata -> *.generated. Dijkstra routes precomputed on the street graph.",
  "laws": ["no-webgl", "no-canvas", "no-tiles", "no-mapbox-leaflet", "baked-osm-not-hand-drawn", "44px-coarse-hit-zones", "reduced-motion-static"]
}
