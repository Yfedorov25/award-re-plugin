{
  "$extends": "cards-swipe",
  "$variant": "editorial",
  "note": "Knob DIFF over the base tokens.json defaults. Skin (split layout, cream/dark themes, copper accent, Georgia/Times serif) is in variant.lab.html CSS — these are the engine knobs that differ.",
  "params": {
    "gap": 0,
    "scrubPerCard": 0.6,
    "snap": true,
    "drag": true,
    "parallax": 0.08,
    "ease": "air"
  },
  "skin": {
    "layout": "two-column-split",
    "gridColumns": "1.18fr 0.82fr",
    "flipAlternates": true,
    "themePerCard": ["cream", "dark"],
    "accent": "#b9885a",
    "serif": "Georgia, 'Times New Roman', serif",
    "headlineStagger": 0.08,
    "renderAfterTextBeat": 0.22,
    "hairlineGutter": true
  }
}
