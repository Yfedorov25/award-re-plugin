{
  "$extends": "cards-swipe",
  "$variant": "cinematic",
  "note": "Knob DIFF over base tokens.json defaults. Skin (dark full-bleed, gold accent, Times serif, line-mask title) is in variant.lab.html CSS — these are the engine knobs that differ.",
  "params": {
    "gap": 0,
    "scrubPerCard": 1.0,
    "snap": true,
    "drag": true,
    "parallax": 0.12,
    "ease": "air"
  },
  "skin": {
    "layout": "fullbleed-single-render",
    "grade": "dark",
    "accent": "#c8a96a",
    "serif": "'Times New Roman', Georgia, ui-serif, serif",
    "scrubSmoothing": 0.7,
    "snapDuration": { "min": 0.2, "max": 0.5 },
    "titleReveal": "line-mask-up",
    "stitch": "bronze"
  }
}
