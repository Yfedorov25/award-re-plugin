{
  "$schema": "../../CONTRACT.md#tokens",
  "id": "cards-swipe",
  "entry": "CardsSwipe.init(opts)",
  "params": {
    "root":         { "type": "string|Element", "default": "#cards", "meaning": "section that gets pinned" },
    "track":        { "type": "string", "default": ".cs-track", "meaning": "the flex row that translateX's" },
    "cards":        { "type": "string", "default": ".cs-card", "meaning": "each card selector" },
    "seam":         { "type": "string|null", "default": null, "meaning": "optional bronze stitch handle element" },
    "gap":          { "type": "number", "default": 24, "range": [0, 96], "unit": "px", "meaning": "gap between cards; MUST equal CSS --cs-gap" },
    "scrubPerCard": { "type": "number", "default": 0.9, "range": [0.4, 1.6], "unit": "vh-fraction", "meaning": "viewport-heights of scroll spent per card transition (pace)" },
    "snap":         { "type": "boolean", "default": true, "meaning": "snap one card per viewport (click-into-place)" },
    "drag":         { "type": "boolean", "default": true, "meaning": "allow pointer fling on top of scroll-scrub" },
    "parallax":     { "type": "number", "default": 0.12, "range": [0, 0.4], "meaning": "inner-image counter-drift (0 = off)" },
    "ease":         { "type": "string", "default": "air", "meaning": "CustomEase name for snap settle" },
    "onCard":       { "type": "function|null", "default": null, "meaning": "(i, card) => {} fired when active card changes" }
  }
}
