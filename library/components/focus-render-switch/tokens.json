{
  "$schema": "../../CONTRACT.md#tokens",
  "id": "focus-render-switch",
  "entry": "FocusRenderSwitch.init(target, options)",
  "params": {
    "slideSel":      { "type": "string", "default": ".frs__slide", "meaning": "each step slide" },
    "headSel":       { "type": "string", "default": ".frs__head", "meaning": "the heading that ticks through its slot" },
    "mediaSel":      { "type": "string", "default": ".frs__media", "meaning": "the render media element" },
    "countSel":      { "type": "string", "default": ".frs__count", "meaning": "step counter element" },
    "scrollPerStep": { "type": "number", "default": 0.9, "range": [0.5, 1.4], "unit": "vh-fraction", "meaning": "scroll per step; pin length = steps * this * 100vh" },
    "stepHold":      { "type": "number", "default": 0.78, "range": [0.5, 0.95], "meaning": "fraction of a step's progress on the current render before swap" },
    "crossfade":     { "type": "number", "default": 0.55, "range": [0.3, 1.0], "unit": "s", "meaning": "render crossfade duration" },
    "kenBurns":      { "type": "boolean", "default": true, "meaning": "slow scale on active slide while held" },
    "kenBurnsFrom":  { "type": "number", "default": 1.0, "meaning": "Ken-Burns start scale" },
    "kenBurnsTo":    { "type": "number", "default": 1.08, "meaning": "Ken-Burns end scale" },
    "headRise":      { "type": "number", "default": 34, "unit": "px", "meaning": "px the heading travels through the slot" },
    "accent":        { "type": "string", "default": "#1aa6c7", "meaning": "word-sweep colour (falls back to CSS --accent)" },
    "ease":          { "type": "string", "default": "air", "meaning": "CustomEase name or any GSAP ease string" },
    "markers":       { "type": "boolean", "default": false, "meaning": "ScrollTrigger debug markers" }
  }
}
