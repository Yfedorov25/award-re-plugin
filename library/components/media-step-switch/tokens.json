{
  "$schema": "../../CONTRACT.md#tokens",
  "id": "media-step-switch",
  "entry": "mediaStepSwitch(stageSel, opts)",
  "params": {
    "scrub":       { "type": "boolean|number", "default": 1, "meaning": "true or smoothing seconds for ScrollTrigger" },
    "pin":         { "type": "boolean", "default": true, "meaning": "pin the stage" },
    "stepVH":      { "type": "number", "default": 100, "unit": "%vh", "meaning": "scroll length per transition" },
    "wave":        { "type": "boolean", "default": true, "meaning": "wavy seam (false = straight horizontal inset wipe)" },
    "waveAmp":     { "type": "number", "default": 7, "range": [0, 20], "unit": "%", "meaning": "ripple amplitude at the wipe midpoint" },
    "waveCols":    { "type": "number", "default": 14, "range": [1, 40], "meaning": "seam edge sample count (ripple detail)" },
    "waveFreq":    { "type": "number", "default": 1.5, "range": [0.5, 4], "meaning": "sine humps across the width" },
    "direction":   { "type": "string", "default": "up", "range": ["up", "down"], "meaning": "which way the new media sweeps in" },
    "overscan":    { "type": "number", "default": 1.06, "range": [1.0, 1.2], "meaning": "image scale so parallax never reveals edges" },
    "pushPercent": { "type": "number", "default": 4, "range": [0, 10], "unit": "%", "meaning": "incoming layer's positional push" },
    "wipeEase":    { "type": "string", "default": "air", "meaning": "CustomEase name (registered) or any gsap ease" },
    "onStep":      { "type": "function|null", "default": null, "meaning": "(index) => {} when a dot turns on" }
  }
}
