{
  "$schema": "../CONTRACT.md#global-tokens",
  "note": "Machine mirror of _tokens.css. Eases register in JS via CustomEase using the points below. Lifted from skills/motion-engine/references/PB_motion_system.md.",
  "ease": {
    "air":          { "css": "cubic-bezier(0.25,0.74,0.22,0.99)", "customEase": "0.25,0.74,0.22,0.99", "use": "house ease — assembly settle, card-up, snap" },
    "out-quad":     { "css": "cubic-bezier(0.25,0.46,0.45,0.94)", "customEase": "0.25,0.46,0.45,0.94", "use": "DEFAULT for UI / quiet sections" },
    "anticipation": { "css": "cubic-bezier(0.68,-0.55,0.27,1.55)", "customEase": "0.68,-0.55,0.27,1.55", "use": "small overshoot / wind-up before a move" },
    "out-expo":     { "css": "cubic-bezier(0.16,1,0.30,1)", "customEase": "0.16,1,0.30,1", "use": "dramatic reveals (puzzle assembly)" }
  },
  "dur": {
    "1": { "s": 0.4, "use": "micro / hover / toggle" },
    "2": { "s": 0.8, "use": "content appears" },
    "3": { "s": 1.6, "use": "slow reveal / hold" },
    "4": { "s": 2.4, "use": "cinematic beat" },
    "5": { "s": 2.8, "use": "longest authored gesture" }
  },
  "stagger": {
    "1": { "ms": 60,  "use": "tight, brisk (editorial)" },
    "2": { "ms": 180, "use": "slow, luxe (cinematic)" }
  },
  "type": {
    "eyebrow": "clamp(11px,0.8vw,13px)",
    "body":    "clamp(15px,1.05vw,18px)",
    "h3":      "clamp(28px,4vw,56px)",
    "h2":      "clamp(40px,7vw,88px)",
    "display": "clamp(56px,9vw,132px)",
    "tracking-tight": "-0.015em"
  },
  "theme": {
    "dark": "#0a0a0a",
    "dark-2": "#141210",
    "cream": "#ece5d8",
    "ink": "#14130f",
    "warm-accent": "#b9885a",
    "gold-accent": "#c8a96a",
    "line-dark": "rgba(20,17,13,0.16)",
    "line-light": "rgba(236,229,216,0.18)"
  },
  "layout": {
    "gutter": "clamp(20px,4.5vw,84px)",
    "radius": "22px"
  }
}
