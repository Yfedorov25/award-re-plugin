scripts/parity/
scripts/scan/
scripts/visual-parity-report.json
scripts/anchor-parity/
library/boards/
extraction/*/.asset-cache/

# S55: сирі live-записи не в git (є файли по 100+ МБ, це вище стелі GitHub).
# Вони НЕ відтворювані, тому зберігати їх треба, але окремо від репо.
library/techniques/atoms/**/reference/*.mov
library/techniques/atoms/**/reference/*.mp4

# S56 (COUNCIL-S55-PLAN крок 4): сирі live-записи в КОРЕНІ атома теж поза git (100+ МБ ламають push)
