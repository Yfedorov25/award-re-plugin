{
  "description": "award-re v1 hooks: state inject · design-grounding gate · live-first-gate (suborganism seam/index потребує свіжого live-ref) · section-gates (prototype-gate + ban AskUserQuestion-копі) · deploy-gate (verify-report обовʼязковий)",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/start-state.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/design-grounding.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/live-first-gate.js",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/section-gates.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/deploy-gate.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}